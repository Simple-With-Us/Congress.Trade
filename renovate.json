{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended", "local>Simple-With-Us/AI-Fleet-Coordinator//renovate-presets/fleet"],
  "dependencyDashboard": true,
  "minimumReleaseAge": "5 days",
  "constraints": {
    "npm": "<12",
    "deno": "2.9.3"
  },
  "packageRules": [
    {
      "matchUpdateTypes": ["minor", "patch", "pin", "digest"],
      "groupName": "non-major dependencies",
      "automerge": true,
      "automergeType": "pr",
      "platformAutomerge": true
    },
    {
      "matchUpdateTypes": ["major"],
      "automerge": false,
      "labels": ["dependencies", "major"]
    },
    {
      "description": "The app ESLint config loads typescript-eslint, whose supported TypeScript range currently ends below 6.1. Keep incompatible compiler upgrades out of Renovate suggestions; revisit this cap in the same PR that upgrades and verifies the parser/plugin support window.",
      "matchManagers": [
        "npm"
      ],
      "matchPackageNames": [
        "typescript"
      ],
      "matchFileNames": [
        "app/package.json"
      ],
      "allowedVersions": "<6.1.0"
    }
  ],
  "vulnerabilityAlerts": { "labels": ["security"] }
}