{
  "imports": {
    "#sentry": "./app/src/deno/sentry.ts",
    "@sentry/deno": "npm:@sentry/deno@^10.70.0",
    "@jaywedgeworth22/congress-trading-shared": "./app/vendor/congress-trading-shared/src/index.ts",
    "hono": "npm:hono@^4.12.31",
    "hono/cookie": "npm:hono@^4.12.31/cookie",
    "node-html-parser": "npm:node-html-parser@^9.0.3",
    "unpdf": "npm:unpdf@^1.6.2",
    "pdf-lib": "npm:pdf-lib@^1.17.1",
    "zod": "npm:zod@^4.4.3",
    "cheerio": "npm:cheerio@^1.2.0",
    "fflate": "npm:fflate@^0.8.3",
    "jsonrepair": "npm:jsonrepair@^3.15.0",
    "@aws-sdk/client-s3": "npm:@aws-sdk/client-s3@3.1146.0",
    "@google/genai": "npm:@google/genai@^2.21.0",
    "@libsql/client": "npm:@libsql/client@^0.18.0",
    "@libsql/client/web": "npm:@libsql/client@^0.18.0/web"
  },
  "exclude": [
    "node_modules",
    "app/node_modules",
    "app/src/__tests__",
    "**/*.test.ts"
  ],
  "compilerOptions": {
    "strict": false,
    "skipLibCheck": true,
    "lib": [
      "deno.window",
      "deno.unstable"
    ]
  },
  "minimumDependencyAge": {
    "age": "PT24H",
    "exclude": [
      "npm:@google/genai"
    ]
  },
  "nodeModulesDir": "none",
  "lock": false,
  "unstable": [
    "sloppy-imports"
  ],
  "deploy": {
    "runtime": {
      "type": "dynamic",
      "entrypoint": "app/src/deno/main.ts"
    },
    "org": "congress-trade",
    "app": "congress-trade"
  }
}
