{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended"],
  "dependencyDashboard": true,
  "minimumReleaseAge": "5 days",
  "packageRules": [
    {
      "description": "Hold the typescript-v5 alias (npm:typescript) below 7.  tsup --dts relies on the classic TypeScript compiler API, which TypeScript 7 removed.",
      "matchPackageNames": ["typescript", "typescript-v5"],
      "matchDepNames": ["typescript-v5"],
      "allowedVersions": "<7"
    },
    {
      "matchUpdateTypes": ["minor", "patch", "pin", "digest"],
      "groupName": "non-major dependencies",
      "automerge": true,
      "automergeType": "pr",
      "platformAutomerge": true
    },
    {
      "matchUpdateTypes": ["major"],
      "automerge": false,
      "labels": ["dependencies", "major"]
    }
  ],
  "vulnerabilityAlerts": { "labels": ["security"], "minimumReleaseAge": null }
}
