{
  "name": "congress-trade",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "main": "src/deno/main.ts",
  "description": "Congress.Trade app: public STOCK Act disclosures (House, Senate, Executive) served from Coolify Deno-in-Docker at congress.trade.",
  "scripts": {
    "start": "deno run --allow-net --allow-env --allow-read src/deno/main.ts",
    "deploy": "echo 'Production deployment is handled by Coolify on push to main'",
    "typecheck": "deno check src/deno/main.ts",
    "test": "vitest run",
    "coverage": "vitest run --coverage",
    "lint": "deno lint",
    "migrate": "npx wrangler d1 migrations apply DB --local",
    "deploy:full": "bash scripts/ship.sh",
    "preview:provision": "bash scripts/provision-preview.sh",
    "preview:deploy": "bash scripts/deploy-preview.sh",
    "sentry:sourcemaps": "node ../scripts/sentry-upload-browser-sourcemaps.mjs",
    "postdeploy": "if [ -n \"$SENTRY_AUTH_TOKEN\" ] && [ -n \"${SENTRY_RELEASE:-$CT_BUILD_SHA$SOURCE_COMMIT}\" ]; then npm run sentry:sourcemaps || echo '::warning::sentry sourcemaps upload failed (non-fatal)'; else echo '::warning::SENTRY_AUTH_TOKEN or release SHA not set; skipping sentry sourcemaps upload'; fi"
  },
  "imports": {
    "#sentry": {
      "deno": "./src/deno/sentry.ts",
      "default": "./src/deno/sentry.ts"
    }
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1146.0",
    "@google/genai": "^2.27.0",
    "@libsql/client": "^0.18.0",
    "@sentry/deno": "^11.4.0",
    "cheerio": "^1.2.0",
    "fflate": "^0.8.3",
    "hono": "^4.13.13",
    "jsonrepair": "^3.15.0",
    "node-html-parser": "^9.0.4",
    "pdf-lib": "^1.17.1",
    "unpdf": "^1.8.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@fontsource/zilla-slab": "^5.3.0",
        "@sentry/cli": "^3.8.0",
        "@types/node": "26.6.4",
    "@typescript-eslint/eslint-plugin": "^8.71.0",
    "@typescript-eslint/parser": "^8.71.0",
    "@vitest/coverage-v8": "^5.0.3",
    "eslint": "^10.12.0",
    "typescript": "^5.6.3",
    "vitest": "^5.0.3",
    "vite": "^8.3.2"
  },
  "overrides": {
    "undici": "^8.0.0"
  }
}
