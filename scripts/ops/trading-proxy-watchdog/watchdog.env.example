# Local configuration for the trading-proxy watchdog.
# Copy to "watchdog.env" in the watchdog root (scripts/ops/ -- the parent
# directory of the folder holding the scripts), fill in the real values,
# and keep the copy OUT of version control (it is listed in .gitignore
# guidance in the README).  public-liveness-watch.sh sources it at start.

# Base URL of the Coolify API for the host that runs Socratic.Trade
# (tailnet address, e.g. http://<coolify-host>:8000/api/v1).
COOLIFY_API=

# Coolify application UUID of the Socratic.Trade app on that host.
COOLIFY_APP_UUID=

# File containing the Coolify API token (mode 600, never committed).
COOLIFY_TOKEN_FILE=$HOME/.secrets/coolify-api-token

# zuliprc for the dedicated Watchdog bot (mode 600, never committed).
# Used by zulip-trading-alert.sh to post confirmed trading-proxy failures.
ZULIPRC=$HOME/.secrets/watchdog-zuliprc

# Public host probed for liveness.
PUBLIC_LIVENESS_HOST=socratictrade.com

# Consecutive site failures before a Coolify restart is issued.
# The VM instance uses 5; the Mac instance uses 8 so the VM stays primary.
PUBLIC_FAIL_THRESHOLD=5
