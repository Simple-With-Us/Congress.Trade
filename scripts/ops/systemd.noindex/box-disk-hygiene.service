[Unit]
Description=Coolify host health and disk hygiene (RAM, swap, inodes, load, disk, safe Docker prune)
After=docker.service
Wants=docker.service

[Service]
Type=oneshot
ExecStart=/usr/local/bin/box-disk-hygiene.sh
Nice=10
IOSchedulingClass=best-effort
IOSchedulingPriority=7
SyslogIdentifier=box-disk-hygiene
# The script sources /etc/box-disk-hygiene.env and then
# /etc/congress-health-recover.env. Do not add a second timer.

[Install]
WantedBy=multi-user.target
