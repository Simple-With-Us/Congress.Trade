[Unit]
Description=Fleet CPU / steal / iowait one-minute sample
After=network-online.target docker.service
Wants=network-online.target

[Service]
Type=oneshot
ExecStart=/usr/local/bin/cpu-sampler.sh
SyslogIdentifier=fleet-cpu-sampler
# EnvironmentFile=-/etc/fleet-cpu-sampler.env

[Install]
WantedBy=multi-user.target
